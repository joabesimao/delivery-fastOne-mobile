# Local: IP da máquina que roda a API. Produção (Vercel/EAS): URL da API no Vercel,
# ex.: https://fastone-api.vercel.app/api (o socket usa a mesma origem por padrão).
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api
EXPO_PUBLIC_SOCKET_URL=http://192.168.0.10:3000
# Cabeçalho da folha de entrega (opcional)
EXPO_PUBLIC_DELIVERY_COMPANY_NAME=FastOne Delivery
EXPO_PUBLIC_DELIVERY_COMPANY_DOCUMENT=
